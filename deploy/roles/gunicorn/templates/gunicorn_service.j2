#####################################
#/etc/systemd/system/gunicorn.service
#####################################

[Unit]
Description=gunicorn daemon ({{ instance_name }})
After=network.target

[Service]
PIDFile=/run/{{ gunicorn_runtime_dir }}/pid-{{ gunicorn_service_name }}
User={{ ansible_env.USER }}
Group={{ ansible_env.USER }}
RuntimeDirectory={{ gunicorn_runtime_dir }}
Environment="PYTHONPATH={{ project_dir }}"
WorkingDirectory={{ project_dir }}
ExecStart={{ venv_path }}/bin/gunicorn --pid /run/{{ gunicorn_runtime_dir }}/pid-{{ gunicorn_service_name }} --timeout {{ gunicorn_timeout }} -w {{ n_workers }} {{ api_app }} --reload --bind {{ bind_server_socket}} --worker-class uvicorn.workers.UvicornWorker
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true

[Install]
WantedBy=multi-user.target
